    "### 4.1 Обработка на Outliers — Capping (Winsorization)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "521b74da",
   "metadata": {},
   "source": [
    "Примена на Capping (Винзоризација)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "61fe3cba",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      " Capping (Winsorization) успешно применет врз приносите.\n",
      "   Математички граници за моделите: [-0.0320, 0.0330]\n",
      "   Визуелни граници во проценти:     [-3.20%, 3.30%]\n"
     ]
    }
   ],
   "source": [
    "\n",
    "q1_raw = df['Daily_Return_Raw'].quantile(0.25)\n",
    "q3_raw = df['Daily_Return_Raw'].quantile(0.75)\n",
    "iqr_raw = q3_raw - q1_raw\n",
    "lower_raw = q1_raw - 1.5 * iqr_raw\n",
    "upper_raw = q3_raw + 1.5 * iqr_raw\n",
    "\n",
    "\n",
    "df['Daily_Return_Cleaned'] = df['Daily_Return_Raw'].clip(lower=lower_raw, upper=upper_raw)\n",
    "\n",
    "\n",
    "cleaned_pct = df['Daily_Return_Cleaned'] * 100\n",
    "lower_pct = lower_raw * 100\n",
    "upper_pct = upper_raw * 100\n",
    "\n",
    "print(f\" Capping (Winsorization) успешно применет врз приносите.\")\n",
    "print(f\"   Математички граници за моделите: [{lower_raw:.4f}, {upper_raw:.4f}]\")\n",
    "print(f\"   Визуелни граници во проценти:     [{lower_pct:.2f}%, {upper_pct:.2f}%]\")"
   ]
