    "from statsmodels.tsa.arima.model import ARIMA\n",
    "import time\n",
    "\n",
    "# 1. Автоматски хронолошки сплит за ARIMA (Решение за Слика 2)\n",
    "split_idx = int(len(df_features) * 0.8)\n",
    "arima_train = df_features['Close'].iloc[:split_idx]\n",
    "arima_test = df_features['Close'].iloc[split_idx:]\n",
    "\n",
    "# 2. Дефиниција на точната Walk-Forward функција\n",
    "def arima_walk_forward_evaluation(train_series, test_series, order=(1,1,1)):\n",
    "    history = list(train_series.values)\n",
    "    predictions = []\n",
    "    \n",
    "    print(\"🚀 Започнува вистинска ARIMA Walk-Forward прогноза на тест сетот...\")\n",
    "    start_time = time.time()\n",
    "    \n",
    "    for t in range(len(test_series)):\n",
    "        model = ARIMA(history, order=order)\n",
    "        model_fit = model.fit()\n",
    "        \n",
    "        # Out-of-sample прогноза на 1 чекор\n",
    "        yhat = model_fit.forecast(steps=1)[0]\n",
    "        predictions.append(yhat)\n",
    "        \n",
    "        # Историјата се проширува со вистинската вредност\n",
    "        history.append(test_series.iloc[t])\n",
    "        \n",
    "        if (t + 1) % 20 == 0 or (t + 1) == len(test_series):\n",
    "            print(f\"   Прогрес: евалуирани {t + 1}/{len(test_series)} денови...\")\n",
    "            \n",
    "    print(f\"✅ Завршено за {time.time() - start_time:.2f} секунди.\")\n",
    "    return pd.Series(predictions, index=test_series.index)\n",
    "\n",
    "# 3. Извршување на моделот\n",
    "arima_preds = arima_walk_forward_evaluation(arima_train, arima_test, order=(1,1,1))"
   ]
