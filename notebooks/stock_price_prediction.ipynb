   "source": [
    "### 8.1 Евалуација и споредба на ML модели"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "18b60c88",
   "metadata": {},
   "source": [
    "Дефинирање на Функцијата за Евалуација"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "9befe664",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      " Функцијата `evaluate_model` е подготвена за работа.\n"
     ]
    }
   ],
   "source": [
    "\n",
    "\n",
    "def evaluate_model(name, model, X_t, y_t, y_tr, X_tr):\n",
    "   \n",
    "    preds = model.predict(X_t)\n",
    "    preds_train = model.predict(X_tr)\n",
    "    \n",
    "    \n",
    "    mae   = mean_absolute_error(y_t, preds)\n",
    "    rmse  = np.sqrt(mean_squared_error(y_t, preds))\n",
    "    r2    = r2_score(y_t, preds)\n",
    "    mape  = np.mean(np.abs((y_t - preds) / (y_t + 1e-9))) * 100\n",
    "    r2_tr = r2_score(y_tr, preds_train)\n",
    "    \n",
    "    return {\n",
    "        \"MAE ($)\": round(mae, 2),\n",
    "        \"RMSE ($)\": round(rmse, 2),\n",
    "        \"R² Test (%)\": round(r2 * 100, 2),\n",
    "        \"R² Train (%)\": round(r2_tr * 100, 2),\n",
    "        \"MAPE (%)\": round(mape, 2),\n",
    "        \"Overfit Gap\": round((r2_tr - r2) * 100, 2)\n",
    "    }\n",
    "\n",
    "print(\" Функцијата `evaluate_model` е подготвена за работа.\")"
   ]
  },
